nextflow_process {

    name "Test Process STAR_ARRIBA"
    script "../main.nf"
    process "STAR_ARRIBA"

    tag "modules"
    tag "modules_local"
    tag "star_arriba"

    setup {
        run("UNTAR") {
            script "../../utility/untar/main.nf"
            process {
            """
            input[0] = Channel.of([
                        [ id:'test_star_arriba'],
                        file('https://raw.githubusercontent.com/TRON-Bioinformatics/test-datasets/long2tx/ref/star_index.tar.gz', checkIfExists: true)
                    ])
            """
            }
        }
    }

    test("star arriba - homo_sapiens - paired_end") {

        when {
            process {
                """
                input[0] = Channel.of([
                            [id:'test_star_arriba'],
                            file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/fastq/test_rnaseq_1.fastq.gz', checkIfExists: true),
                            file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/fastq/test_rnaseq_2.fastq.gz', checkIfExists: true),
                        ]).join(UNTAR.out.untar)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("star arriba - homo_sapiens - paired_end - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = Channel.of([
                            [id:'test_star_arriba'],
                            file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/fastq/test_rnaseq_1.fastq.gz', checkIfExists: true),
                            file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/fastq/test_rnaseq_2.fastq.gz', checkIfExists: true),
                        ]).join(UNTAR.out.untar)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}